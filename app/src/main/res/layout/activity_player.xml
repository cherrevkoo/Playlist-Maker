<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/arrow_back"
            android:background="@android:color/transparent"
            app:tint="@color/playlist_back" />

        <ImageView
            android:id="@+id/track_cover"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:layout_marginTop="26dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder"
            app:layout_constraintTop_toBottomOf="@id/backButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/trackName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:text="xcvbjklkjhgf"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/ys_display_medium"
            android:textColor="@color/search_text_color"
            app:layout_constraintTop_toBottomOf="@id/track_cover"
            app:layout_constraintStart_toStartOf="@id/track_cover"
            app:layout_constraintEnd_toEndOf="@id/track_cover"
           />

        <TextView
            android:id="@+id/artistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:text="cvbhjkl;lkjhgf"
            android:fontFamily="@font/ys_display_medium"
            android:singleLine="true"
            android:textColor="@color/search_text_color"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/track_cover"
            app:layout_constraintEnd_toEndOf="@id/track_cover"
            app:layout_constraintTop_toBottomOf="@id/trackName" />

        <ImageButton
            android:id="@+id/add_to_playlist_button"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:background="@drawable/little_button_background"
            app:layout_constraintTop_toTopOf="@id/play_button"
            app:layout_constraintBottom_toBottomOf="@id/play_button"
            app:layout_constraintTop_toBottomOf="@id/artistName"
            app:layout_constraintStart_toStartOf="@id/track_cover"
            android:src="@drawable/button_add_to_playlist" />

        <ImageButton
            android:id="@+id/play_button"
            android:layout_width="83dp"
            android:layout_height="83dp"
            android:src="@drawable/button_play"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/artistName"

            android:layout_marginTop="24dp"
            app:layout_constraintStart_toEndOf="@id/add_to_playlist_button"
            app:layout_constraintEnd_toStartOf="@id/button_like"/>

        <ImageButton
            android:id="@+id/button_like"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:background="@drawable/little_button_background"
            app:layout_constraintTop_toTopOf="@id/play_button"
            app:layout_constraintBottom_toBottomOf="@id/play_button"
            app:layout_constraintEnd_toEndOf="@id/track_cover"
            android:src="@drawable/button_like"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/play_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/play_time"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/play_button"
            android:layout_marginTop="17dp"
            android:text="0.00"
            android:fontFamily="@font/ys_display_medium"
            android:textSize="14sp"

            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.4"
            app:layout_constraintTop_toBottomOf="@id/play_time"/>


        <TextView
            android:id="@+id/label_duration"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:text="Длительность"
            android:textColor="#AEAFB4"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/value_duration"
            app:layout_constraintTop_toBottomOf="@id/play_time"
            app:layout_constraintBottom_toTopOf="@id/label_duration"

            />

        <TextView
            android:id="@+id/value_duration"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text=""
            android:textColor="@color/button_text"
            android:layout_marginEnd="24dp"
            android:textSize="13sp"
            android:gravity="center_vertical|end"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="@id/guideline_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/label_duration"
           />

        <TextView
            android:id="@+id/label_album"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:text="Альбом"
            android:textColor="#AEAFB4"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/value_album"
            app:layout_constraintTop_toBottomOf="@id/label_duration"
            app:layout_constraintBottom_toTopOf="@id/label_year"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/value_album"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text=""
            android:textColor="@color/button_text"
            android:layout_marginEnd="24dp"
            android:textSize="13sp"
            android:gravity="center_vertical|end"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="@id/guideline_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/label_album"/>

        <TextView
            android:id="@+id/label_year"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:text="Год"
            android:textColor="#AEAFB4"
            android:gravity="center_vertical"
            android:textSize="13sp"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/value_year"
            app:layout_constraintTop_toBottomOf="@id/label_album"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toTopOf="@id/label_genre"/>

        <TextView
            android:id="@+id/value_year"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="24dp"
            android:text=""
            android:gravity="center_vertical|end"
            android:textColor="@color/button_text"
            android:textSize="13sp"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="@id/guideline_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/label_year" />

        <TextView
            android:id="@+id/label_genre"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:text="Жанр"
            android:gravity="center_vertical"
            android:textColor="#AEAFB4"
            android:textSize="13sp"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/value_genre"
            app:layout_constraintTop_toBottomOf="@id/label_year"
            app:layout_constraintBottom_toTopOf="@id/label_country"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/value_genre"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:text=""
            android:gravity="center_vertical|end"
            android:textColor="@color/button_text"
            android:layout_marginEnd="24dp"
            android:textSize="13sp"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="@id/guideline_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/label_genre"/>

        <TextView
            android:id="@+id/label_country"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:text="Страна"
            android:gravity="center_vertical"
            android:textColor="#AEAFB4"
            android:textSize="13sp"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/value_country"
            app:layout_constraintTop_toBottomOf="@id/label_genre"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/value_country"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="24dp"
            android:text=""
            android:textColor="@color/button_text"
            android:textSize="13sp"
            android:gravity="center_vertical|end"
            android:fontFamily="@font/ys_display_regular"
            app:layout_constraintStart_toStartOf="@id/guideline_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/label_country"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>