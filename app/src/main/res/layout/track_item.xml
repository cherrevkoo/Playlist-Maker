<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/track_item_padding"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/track_icon"
        android:layout_width="@dimen/track_icon_size"
        android:layout_height="@dimen/track_icon_size"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/track_icon_margin_start"/>

    <LinearLayout

        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/track_text_padding_start">

        <TextView
            android:id="@+id/trackName"
            style="@style/trackNameStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/artist_and_time"
            style="@style/trackInfoStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/track_info_margin_top"/>

    </LinearLayout>

</LinearLayout>