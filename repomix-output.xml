<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/search_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/search_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/arrow_back"
        app:navigationIconTint="@color/toolbar_navigation_icon"
        app:title="@string/search"
        app:titleTextAppearance="@style/Toolbar.TitleText" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:layout_marginStart="@dimen/button_margin_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/button_margin_horizontal">

        <EditText
            android:id="@+id/searchEditText"
            style="@style/SearchEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:autofillHints="search"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="@dimen/button_margin_horizontal"
            android:paddingEnd="48dp"
            android:textColorHint="@color/search_line_text"
            tools:ignore="LabelFor" />

        <ImageButton
            android:id="@+id/clearButton"
            android:layout_width="36dp"
            android:layout_height="29dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clear"
            android:visibility="gone"/>
    </FrameLayout>

    <TextView
        android:id="@+id/historyTitle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/you_were_looking_for"
        android:textSize="19sp"
        android:textColor="@color/search_text_color"
        android:fontFamily="@font/ys_display_medium"
        android:gravity="center"
        android:paddingTop="24dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/clearHistoryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|center_vertical"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/placeholderButtonBackground"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/clear_history"
        android:textColor="@color/placeholderButtonTextColor"
        android:textSize="19sp"
        app:cornerRadius="54dp"
        />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/button_margin_vertical"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="80dp"
            android:indeterminateTint="@color/debounce_color"
            />



    <LinearLayout
        android:id="@+id/placeholderLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/search_background"
        android:layout_marginTop="102dp">

        <ImageView
            android:id="@+id/placeholderImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/placeholder_empty"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/search" />

        <TextView
            android:id="@+id/placeholderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/internet_problem"
            android:textSize="19sp"
            android:fontFamily="@font/ys_display_medium"
            android:textColor="@color/search_text_color"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/placeholderText"
            android:layout_width="312dp"
            android:layout_height="wrap_content"
            android:text="@string/nothing_is_found"
            android:textColor="@color/placeholderTextColor"
            android:fontFamily="@font/ys_display_medium"
            android:layout_marginTop="8dp"
            android:textSize="19sp"
            android:textAlignment="center"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/placeholderRetryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update"
                android:textSize="19sp"
                android:backgroundTint="@color/placeholderButtonBackground"
                android:textColor="@color/placeholderButtonTextColor"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/ys_display_medium"/>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
</file>

